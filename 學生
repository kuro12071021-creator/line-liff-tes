<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>マイコーナー - 學生學習空間</title>
    <!-- 引入日系文青圓體 Zen Maru Gothic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">
    <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Zen Maru Gothic', sans-serif !important;
            background-color: #fdfcf0;
            color: #5c5043;
            margin: 0;
            padding: 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            width: 100%;
            max-width: 380px;
            background: white;
            padding: 35px 25px 25px 25px;
            border-radius: 25px;
            box-shadow: 0 10px 25px rgba(168, 143, 117, 0.15);
            margin: auto;
        }
        h2 {
            color: #b89c7a;
            margin-top: 0;
            margin-bottom: 5px;
            font-size: 1.6em;
            font-weight: 700;
            letter-spacing: 2px;
        }
        #status {
            color: #8c7863;
            font-size: 15px;
            margin: 15px 0 30px 0;
            font-weight: 500;
        }
        .menu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .menu-btn {
            background: #fffaf0;
            border: 2px solid #e8e0c9;
            padding: 25px 10px;
            border-radius: 18px;
            font-size: 16px;
            font-weight: 700;
            color: #786c5e;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(219, 206, 182, 0.3);
        }
        .menu-btn:active {
            background: #e8e0c9;
            transform: translateY(2px);
            box-shadow: none;
        }
        .menu-btn span {
            font-size: 28px;
            margin-bottom: 8px;
        }
        .footer-art {
            margin-top: 25px;
            opacity: 0.9;
        }
        .cute-shiba {
            font-size: 26px;
            letter-spacing: 8px;
        }
        .user-id {
            color: #d1cbc1;
            font-size: 10px;
            margin-top: 15px;
            margin-bottom: 0;
        }

        /* 自訂美觀彈窗背景遮罩 */
        #custom-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(92, 80, 67, 0.4);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        /* 彈窗本體 */
        .modal-content {
            background: #fff;
            padding: 25px 20px;
            border-radius: 20px;
            width: 85%;
            max-width: 320px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            text-align: center;
        }
        .modal-title {
            color: #b89c7a;
            font-size: 1.2em;
            font-weight: 700;
            margin-bottom: 15px;
        }
        .modal-text {
            color: #5c5043;
            font-size: 15px;
            white-space: pre-line;
            line-height: 1.6;
            margin-bottom: 20px;
            text-align: center;
            background: #fdfcf0;
            padding: 15px;
            border-radius: 12px;
        }
        .modal-btn {
            background: #b89c7a;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 20px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>🌸 マイコーナー 🌸</h2>
        <p id="status">正在載入您的專屬空間...</p>

        <!-- 2大核心功能按鈕 -->
        <div class="menu-grid">
            <a href="#" id="btn-schedule" class="menu-btn" onclick="showSchedule(event)">
                <span>📅</span>課程時間
            </a>
            <a href="#" id="btn-meet" target="_blank" class="menu-btn" onclick="checkLink(event)">
                <span>💻</span>Teams上課
            </a>
        </div>

        <!-- 底部可愛柴犬區塊 -->
        <div class="footer-art">
            <div class="cute-shiba">
                🐾 🐕 🐾
            </div>
        </div>

        <p class="user-id" id="user-id"></p>
    </div>

    <!-- 自訂彈跳視窗 -->
    <div id="custom-modal">
        <div class="modal-content">
            <div class="modal-title" id="modal-title">📅 課程時間</div>
            <div id="modal-text" class="modal-text"></div>
            <button class="modal-btn" onclick="closeModal()">確定</button>
        </div>
    </div>

    <script>
        // ==========================================
        // 🛠️ 內容與連結設定區塊
        // ==========================================
        const CONFIG = {
            // Microsoft Teams 上課會議連結
            teamsUrl: "https://teams.live.com/l/invite/FEAQ495qcf0JrSf4g?v=g1", 
            
            // 點擊「課程時間」時彈出的文字內容（可自行修改）
            scheduleText: "每週固定上課時間：\n請依約定時間準時上課唷！\n\n如有請假或調課需求，請提前聯繫老師 🌸"
        };

        async function main() {
            try {
                // 初始化 LIFF
                await liff.init({ liffId: "2010817935-88LjVidu" });

                if (!liff.isLoggedIn()) {
                    liff.login();
                    return;
                }

                // 取得 LINE 使用者名稱與 ID
                const profile = await liff.getProfile();
                const lineId = profile.userId;
                const displayName = profile.displayName;
                
                document.getElementById('user-id').innerText = `ID: ${lineId}`;
                document.getElementById('status').innerText = `🌸 歡迎回來，${displayName}！`;

                // 套用 Teams 連結
                if (CONFIG.teamsUrl && CONFIG.teamsUrl !== "https://") {
                    document.getElementById('btn-meet').href = CONFIG.teamsUrl;
                }

            } catch (error) {
                document.getElementById('status').innerText = '🌸 歡迎來到學生學習空間';
                console.error('Error:', error);
            }
        }

        // 點擊「課程時間」時顯示彈窗
        function showSchedule(event) {
            event.preventDefault();
            document.getElementById('modal-text').innerText = CONFIG.scheduleText;
            document.getElementById('custom-modal').style.display = 'flex';
        }

        // 關閉彈窗
        function closeModal() {
            document.getElementById('custom-modal').style.display = 'none';
        }

        // 連結尚未設定時的防呆提示
        function checkLink(event) {
            const url = event.currentTarget.getAttribute('href');
            if (!url || url === "#" || url === "https://") {
                event.preventDefault();
                alert('目前尚未設定此專屬連結，請聯繫老師唷！');
            }
        }

        main();
    </script>
</body>
</html>
